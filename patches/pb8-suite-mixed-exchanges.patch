index 4fedffbec..3299bac0d 100644
--- a/tests/test_suite_runner.py
+++ b/tests/test_suite_runner.py
@@ -1233,3 +1233,12 @@ def test_saved_suite_config_preserves_effective_exchange_defaults(monkeypatch, t
     assert observed == [["bybit"]]
     assert resumed[0].exchanges == observed[0]
     assert config["backtest"]["exchanges"] == ["binance"]
+
+
+def test_mixed_dataset_exchange_universe_preserves_combined_contributors():
+    from suite_runner import _dataset_available_exchanges
+    combined = SimpleNamespace(exchange="combined", available_exchanges=["binance", "bybit"])
+    restricted = SimpleNamespace(exchange="binance")
+    assert _dataset_available_exchanges({"combined": combined, "binance": restricted}) == ["binance", "bybit"]
+    assert _dataset_available_exchanges({"combined": combined}) == ["binance", "bybit"]
+    assert _dataset_available_exchanges({"binance": restricted}) == ["binance"]
